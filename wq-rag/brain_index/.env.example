# 复制为 .env 后填入真实值（.env 已在 .gitignore，不入 git）。
# 模板里只放占位符，避免泄露内网拓扑。

# Embedding provider: bgem3 (default) | doubao | voyage | openai
EMBEDDING_PROVIDER=bgem3

# --- BGE-M3 (vLLM 自托管 pooling endpoint，dense+sparse 单次返回) ---
# 形如 http://<host>:<port>，需暴露 /pooling 与 /v1/models 接口
BGEM3_BASE_URL=http://<bge-m3-host>:<port>
BGEM3_POOLING_PATH=/pooling

# --- Doubao (dense-only 备选, 火山方舟 OpenAI 兼容) ---
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
DOUBAO_API_KEY=<ark-api-key>
DOUBAO_MODEL=doubao-embedding-vision
DOUBAO_DIM=1024

# --- Voyage (dense-only 备选) ---
VOYAGE_API_KEY=<voyage-api-key>

# --- OpenAI (dense-only 备选) ---
OPENAI_API_KEY=<openai-api-key>

# --- Qdrant ---
QDRANT_HOST=<qdrant-host>
QDRANT_PORT=6333
QDRANT_COLLECTION=brain_kb_bgem3

# --- 索引逻辑版本，改 TAG_RULES / 切分阈值后手动 bump（v1.0 → v1.1）---
INDEX_VERSION=v1.0

# --- 数据源根目录（指向 wq-doc-forum 爬虫产物，相对 brain_index/）---
DATA_ROOT=../wq-doc-forum/data
